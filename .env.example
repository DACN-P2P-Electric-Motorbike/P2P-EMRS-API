# Application Mode
NODE_ENV=development
PORT=3000

# PostgreSQL Configuration (Docker-Compose / Local)
POSTGRES_USER=emrs_user
POSTGRES_PASSWORD=emrs_secret
POSTGRES_DB=emrs_db
POSTGRES_PORT=5432

# Prisma Database URL
# In Development (Docker), Prisma will connect to the postgres container using these variables
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Aiven RDS Database (Production / Override)
# DATABASE_URL="postgres://avnadmin:...@pg-hostname:17032/defaultdb?sslmode=require"

# JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET_HERE
# Optional separate signing secret for incident upload receipts; defaults to JWT_SECRET
INCIDENT_EVIDENCE_RECEIPT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

#Nodemailer Setup
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="Dream Ride" <your-email@gmail.com>

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_BUCKET_URL=https://your-bucket-name.s3.ap-southeast-1.amazonaws.com
